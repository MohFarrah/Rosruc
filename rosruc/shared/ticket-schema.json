{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Support Ticket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "status",
    "logs",
    "report",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "examples": ["created", "running", "report_ready"]
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "report": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "./report-schema.json#/$defs/report"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
